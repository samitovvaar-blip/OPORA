rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Личное: каждый видит только свои данные
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Общее пространство владельца ({ws} = uid владельца)
    function isOwner(ws) { return request.auth != null && request.auth.uid == ws; }
    // Сотрудник: почта подтверждена письмом, есть в списке, доступ открыт
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function isMember(ws) {
      let w = get(/databases/$(database)/documents/workspaces/$(ws)).data;
      return verified() && w.open == true
        && request.auth.token.email.lower() in w.members;
    }

    match /workspaces/{ws} {
      allow read: if isOwner(ws)
        || (verified() && request.auth.token.email.lower() in resource.data.members) || isStudent(ws);
      allow write: if isOwner(ws);

      match /assignments/{id} {
        // Сотрудник видит только задания, открытые ему (shared)
        allow read: if isOwner(ws) || (isMember(ws) && resource.data.shared == true);
        allow create, delete: if isOwner(ws);
        // Сотрудник может менять только чекпоинты, статус и отметки по дням (регулярные):
        // статус — из списка, чекпоинтов столько же (не добавить и не удалить)
        allow update: if isOwner(ws) || (isMember(ws) && resource.data.shared == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["checkpoints", "status", "doneDates"])
          && request.resource.data.status in ["todo", "doing", "done"]
          && (!("doneDates" in request.resource.data) || (request.resource.data.doneDates is list && request.resource.data.doneDates.size() <= 90))
          && request.resource.data.checkpoints is list
          && request.resource.data.checkpoints.size() == resource.data.checkpoints.size());
      }
    }

    // Недельная обратная связь Neila. Ответ видят автор и владелец.
    match /workspaces/{ws}/feedbackWeeks/{week}/roles/{role}/responses/{email} {
      function isRespondent() {
        return verified() && request.auth.token.email.lower() == email
          && ((role == "staff" && isMember(ws)) || (role == "student" && isStudent(ws)));
      }
      function validAnswer(answer) {
        return answer is string && answer.size() > 0 && answer.size() <= 1000;
      }
      function validResponse() {
        let data = request.resource.data;
        let answers = data.answers;
        return week.matches("[0-9]{4}-[0-9]{2}-[0-9]{2}")
          && data.keys().hasOnly(["answers", "submittedAt"])
          && data.submittedAt == request.time
          && answers is list && answers.size() == 5
          && validAnswer(answers[0]) && validAnswer(answers[1])
          && validAnswer(answers[2]) && validAnswer(answers[3]) && validAnswer(answers[4]);
      }
      allow get: if isOwner(ws) || isRespondent();
      allow list: if isOwner(ws);
      allow create: if isRespondent() && validResponse();
    }

    // Оплата сотрудника: ведёт владелец, сотрудник видит только свою карточку
    match /workspaces/{ws}/staff/{email} {
      allow read: if isOwner(ws) || (isMember(ws) && request.auth.token.email.lower() == email);
      allow write: if isOwner(ws);
    }

    // Онлайн и рабочее время сотрудника: пишет сам сотрудник (только свою карточку), смотрит владелец
    match /workspaces/{ws}/presence/{email} {
      allow read: if isOwner(ws) || (isMember(ws) && request.auth.token.email.lower() == email);
      function canMarkClientPresence() {
        let legacy = /databases/$(database)/documents/clientIndex/$(email);
        let cid = request.resource.data.get("cid", "");
        return verified() && ((cid is string && cid != ""
          && isClient(get(/databases/$(database)/documents/workspaces/$(ws)/clients/$(cid)).data))
          || (cid == "" && exists(legacy) && get(legacy).data.ws == ws
            && isClient(get(/databases/$(database)/documents/workspaces/$(ws)/clients/$(get(legacy).data.cid)).data)));
      }
      allow write: if request.auth != null && request.auth.token.email.lower() == email
        && (isMember(ws) || canMarkClientPresence())
        && request.resource.data.keys().hasOnly(["lastSeen", "days", "cid"]);
    }

    // Прогресс по курсам: сотрудник отмечает просмотренные уроки (только свои), смотрит владелец
    match /workspaces/{ws}/progress/{email} {
      allow read: if isOwner(ws) || ((isMember(ws) || isStudent(ws)) && request.auth.token.email.lower() == email);
      allow write: if (isMember(ws) || isStudent(ws)) && request.auth.token.email.lower() == email
        && request.resource.data.keys().hasOnly(["done"]) && request.resource.data.done is list && request.resource.data.done.size() <= 500;
    }

    // База знаний: ведёт владелец, сотрудник смотрит
    // сотрудник видит уроки только тех курсов, что владелец открыл ему (staff/{email}.courses)
    match /workspaces/{ws}/kb/{id} {
      allow read: if isOwner(ws) || (isMember(ws) && resource.data.get("course", "") in
        get(/databases/$(database)/documents/workspaces/$(ws)/staff/$(request.auth.token.email.lower())).data.get("courses", []))
        || (isStudent(ws) && resource.data.get("course", "") in
        get(/databases/$(database)/documents/workspaces/$(ws)/students/$(request.auth.token.email.lower())).data.get("courses", []));
      allow write: if isOwner(ws);
    }

    // Ученик: где его кабинет (пишет владелец, читает сам ученик)
    match /studentIndex/{email} {
      allow read: if verified() && request.auth.token.email.lower() == email;
      allow create: if request.auth != null && request.resource.data.ws == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ws == request.auth.uid;
    }
    function isStudent(ws) {
      return verified() && exists(/databases/$(database)/documents/workspaces/$(ws)/students/$(request.auth.token.email.lower()));
    }
    // Карточка ученика: курсы и домашки ведёт владелец; ученик отмечает только «сдано» (hwDone)
    match /workspaces/{ws}/students/{email} {
      allow read: if isOwner(ws) || (verified() && request.auth.token.email.lower() == email);
      allow write: if isOwner(ws);
      allow update: if verified() && request.auth.token.email.lower() == email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["hwDone"]);
    }

    // Клиент: где его кабинет (пишет владелец, читает сам клиент)
    match /clientIndex/{email} {
      allow read: if verified() && request.auth.token.email.lower() == email;
      allow create: if request.auth != null && request.resource.data.ws == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ws == request.auth.uid;
    }
    match /clientIndex/{email}/cabinetGrants/{id} {
      allow read: if verified() && request.auth.token.email.lower() == email;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(["ws", "cid"])
        && request.resource.data.ws == request.auth.uid
        && request.resource.data.cid is string
        && id == request.auth.uid + "_" + request.resource.data.cid
        && (resource == null || resource.data.ws == request.auth.uid);
      allow delete: if request.auth != null
        && (resource == null || resource.data.ws == request.auth.uid);
    }
    function isClient(data) {
      return verified() && data.clientOpen == true
        && request.auth.token.email.lower() in data.get("clientEmails", []);
    }

    // Проекты-клиенты: ведёт владелец; сотрудник видит только открытые ему, клиент — свой
    match /workspaces/{ws}/clients/{cid} {
      // сотрудник видит только своих клиентов (его почта в staffEmails)
      allow read: if isOwner(ws) || isClient(resource.data) || (isMember(ws)
        && (request.auth.token.email.lower() in resource.data.get("staffEmails", [])));
      allow write: if isOwner(ws);
      // клиент может править «Данные от ОП» и «Планирование», только если владелец открыл доступ (opEdit)
      allow update: if isClient(resource.data) && resource.data.get("opEdit", false) == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["sales", "prepay", "kpi", "planSales", "plans", "payCal"]);

      // Клиент на услугах ведёт свой платёжный календарь вместе с мини-CRM.
      allow update: if isClient(resource.data) && resource.data.get("bizType", "") == "services"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["payCal"])
        && request.resource.data.payCal is map;

      // Мини-CRM клиента на услугах (свои клиенты, проекты, доходы и расходы): ведёт сам клиент, владелец видит и может править
      match /crm/{id} {
        allow read: if isOwner(ws) || isClient(get(/databases/$(database)/documents/workspaces/$(ws)/clients/$(cid)).data)
          || (isMember(ws) && request.auth.token.email.lower() in get(/databases/$(database)/documents/workspaces/$(ws)/clients/$(cid)).data.get("staffEmails", []));
        allow write: if isOwner(ws) || (isClient(get(/databases/$(database)/documents/workspaces/$(ws)/clients/$(cid)).data)
          && (request.resource == null || (request.resource.data.kind in ["client", "project", "move", "product", "regular", "employee"] && request.resource.data.size() <= 20)));
      }

      // Снимки сданных месяцев (заморозка цифр): пишет владелец, читают все, кто видит кабинет
      match /snapshots/{month} {
        allow read: if isOwner(ws) || isClient(get(/databases/$(database)/documents/workspaces/$(ws)/clients/$(cid)).data)
          || (isMember(ws) && request.auth.token.email.lower() in get(/databases/$(database)/documents/workspaces/$(ws)/clients/$(cid)).data.get("staffEmails", []));
        allow write: if isOwner(ws);
      }

      // Отметки за месяц: сотрудник ставит галочку и пишет комментарий
      match /months/{month}/items/{id} {
        function opened() {
          let c = get(/databases/$(database)/documents/workspaces/$(ws)/clients/$(cid)).data;
          return request.auth.token.email.lower() in c.get("staffEmails", []);
        }
        allow read: if isOwner(ws) || (isMember(ws) && opened())
          || isClient(get(/databases/$(database)/documents/workspaces/$(ws)/clients/$(cid)).data);
        allow delete: if isOwner(ws);
        allow create, update: if isOwner(ws) || (isMember(ws) && opened()
          && request.resource.data.keys().hasOnly(["done", "doneBy", "doneAt", "comment", "commentBy", "commentAt"])
          && (!("comment" in request.resource.data) || (request.resource.data.comment is string && request.resource.data.comment.size() <= 1000)));
        // Клиент отвечает на вопрос по пункту (только поля ответа)
        allow create: if isClient(get(/databases/$(database)/documents/workspaces/$(ws)/clients/$(cid)).data)
          && request.resource.data.keys().hasOnly(["reply", "replyAt", "replyBy"]) && request.resource.data.reply is string && request.resource.data.reply.size() <= 1000;
        allow update: if isClient(get(/databases/$(database)/documents/workspaces/$(ws)/clients/$(cid)).data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reply", "replyAt", "replyBy"])
          && request.resource.data.reply is string && request.resource.data.reply.size() <= 1000;
      }
    }

    // Приглашение открывает только отдельный интерфейс с вымышленными данными.
    match /demoInvites/{email} {
      function validInvite() {
        let data = request.resource.data;
        return data.keys().hasOnly(["owner", "issuedAt", "offers"])
          && isOwner(data.owner)
          && exists(/databases/$(database)/documents/workspaces/$(data.owner))
          && data.issuedAt == request.time
          && data.offers is list && data.offers.size() >= 1 && data.offers.size() <= 3
          && data.offers[0] is string && data.offers[0].size() > 0 && data.offers[0].size() <= 180
          && (data.offers.size() < 2 || (data.offers[1] is string && data.offers[1].size() <= 180))
          && (data.offers.size() < 3 || (data.offers[2] is string && data.offers[2].size() <= 180));
      }
      allow get: if request.auth != null && (
        resource == null || isOwner(resource.data.owner)
        || (verified() && request.auth.token.email.lower() == email
          && request.time < resource.data.issuedAt + duration.value(3, "d")));
      allow list: if isOwner(resource.data.owner);
      allow create: if request.auth != null && validInvite();
      allow update: if isOwner(resource.data.owner) && validInvite();
      allow delete: if isOwner(resource.data.owner);
    }

    // Всё остальное закрыто
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
