rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Личное: каждый видит только свои данные
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Общее пространство владельца ({ws} = uid владельца)
    function isOwner(ws) { return request.auth != null && request.auth.uid == ws; }
    // Сотрудник: почта подтверждена письмом, есть в списке, доступ открыт
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function isMember(ws) {
      let w = get(/databases/$(database)/documents/workspaces/$(ws)).data;
      return verified() && w.open == true
        && request.auth.token.email.lower() in w.members;
    }

    match /workspaces/{ws} {
      allow read: if isOwner(ws)
        || (verified() && request.auth.token.email.lower() in resource.data.members);
      allow write: if isOwner(ws);

      match /assignments/{id} {
        // Сотрудник видит только задания, открытые ему (shared)
        allow read: if isOwner(ws) || (isMember(ws) && resource.data.shared == true);
        allow create, delete: if isOwner(ws);
        // Сотрудник может менять только чекпоинты, статус и отметки по дням (регулярные):
        // статус — из списка, чекпоинтов столько же (не добавить и не удалить)
        allow update: if isOwner(ws) || (isMember(ws) && resource.data.shared == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["checkpoints", "status", "doneDates"])
          && request.resource.data.status in ["todo", "doing", "done"]
          && (!("doneDates" in request.resource.data) || (request.resource.data.doneDates is list && request.resource.data.doneDates.size() <= 90))
          && request.resource.data.checkpoints is list
          && request.resource.data.checkpoints.size() == resource.data.checkpoints.size());
      }
    }

    // Оплата сотрудника: ведёт владелец, сотрудник видит только свою карточку
    match /workspaces/{ws}/staff/{email} {
      allow read: if isOwner(ws) || (isMember(ws) && request.auth.token.email.lower() == email);
      allow write: if isOwner(ws);
    }

    // Онлайн и рабочее время сотрудника: пишет сам сотрудник (только свою карточку), смотрит владелец
    match /workspaces/{ws}/presence/{email} {
      allow read: if isOwner(ws) || (isMember(ws) && request.auth.token.email.lower() == email);
      // пишет сам сотрудник или клиент этого кабинета (clientIndex/{email}.ws == ws) — только свою отметку
      allow write: if request.auth != null && request.auth.token.email.lower() == email
        && (isMember(ws) || (verified() && get(/databases/$(database)/documents/clientIndex/$(email)).data.ws == ws))
        && request.resource.data.keys().hasOnly(["lastSeen", "days"]);
    }

    // Прогресс по курсам: сотрудник отмечает просмотренные уроки (только свои), смотрит владелец
    match /workspaces/{ws}/progress/{email} {
      allow read: if isOwner(ws) || (isMember(ws) && request.auth.token.email.lower() == email);
      allow write: if isMember(ws) && request.auth.token.email.lower() == email
        && request.resource.data.keys().hasOnly(["done"]) && request.resource.data.done is list && request.resource.data.done.size() <= 500;
    }

    // База знаний: ведёт владелец, сотрудник смотрит
    // сотрудник видит уроки только тех курсов, что владелец открыл ему (staff/{email}.courses)
    match /workspaces/{ws}/kb/{id} {
      allow read: if isOwner(ws) || (isMember(ws) && resource.data.get("course", "") in
        get(/databases/$(database)/documents/workspaces/$(ws)/staff/$(request.auth.token.email.lower())).data.get("courses", []));
      allow write: if isOwner(ws);
    }

    // Клиент: где его кабинет (пишет владелец, читает сам клиент)
    match /clientIndex/{email} {
      allow read: if verified() && request.auth.token.email.lower() == email;
      allow create: if request.auth != null && request.resource.data.ws == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ws == request.auth.uid;
    }
    function isClient(data) {
      return verified() && data.clientOpen == true
        && request.auth.token.email.lower() in data.get("clientEmails", []);
    }

    // Проекты-клиенты: ведёт владелец; сотрудник видит только открытые ему, клиент — свой
    match /workspaces/{ws}/clients/{cid} {
      // сотрудник видит только своих клиентов (его почта в staffEmails)
      allow read: if isOwner(ws) || isClient(resource.data) || (isMember(ws)
        && (request.auth.token.email.lower() in resource.data.get("staffEmails", [])));
      allow write: if isOwner(ws);

      // Снимки сданных месяцев (заморозка цифр): пишет владелец, читают все, кто видит кабинет
      match /snapshots/{month} {
        allow read: if isOwner(ws) || isClient(get(/databases/$(database)/documents/workspaces/$(ws)/clients/$(cid)).data)
          || (isMember(ws) && request.auth.token.email.lower() in get(/databases/$(database)/documents/workspaces/$(ws)/clients/$(cid)).data.get("staffEmails", []));
        allow write: if isOwner(ws);
      }

      // Отметки за месяц: сотрудник ставит галочку и пишет комментарий
      match /months/{month}/items/{id} {
        function opened() {
          let c = get(/databases/$(database)/documents/workspaces/$(ws)/clients/$(cid)).data;
          return request.auth.token.email.lower() in c.get("staffEmails", []);
        }
        allow read: if isOwner(ws) || (isMember(ws) && opened())
          || isClient(get(/databases/$(database)/documents/workspaces/$(ws)/clients/$(cid)).data);
        allow delete: if isOwner(ws);
        allow create, update: if isOwner(ws) || (isMember(ws) && opened()
          && request.resource.data.keys().hasOnly(["done", "doneBy", "doneAt", "comment", "commentBy", "commentAt"])
          && (!("comment" in request.resource.data) || (request.resource.data.comment is string && request.resource.data.comment.size() <= 1000)));
        // Клиент отвечает на вопрос по пункту (только поля ответа)
        allow create: if isClient(get(/databases/$(database)/documents/workspaces/$(ws)/clients/$(cid)).data)
          && request.resource.data.keys().hasOnly(["reply", "replyAt", "replyBy"]) && request.resource.data.reply is string && request.resource.data.reply.size() <= 1000;
        allow update: if isClient(get(/databases/$(database)/documents/workspaces/$(ws)/clients/$(cid)).data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reply", "replyAt", "replyBy"])
          && request.resource.data.reply is string && request.resource.data.reply.size() <= 1000;
      }
    }

    // Всё остальное закрыто
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
