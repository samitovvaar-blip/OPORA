rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Личное: каждый видит только свои данные
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Общее пространство владельца ({ws} = uid владельца)
    function isOwner(ws) { return request.auth != null && request.auth.uid == ws; }
    function isMember(ws) {
      let w = get(/databases/$(database)/documents/workspaces/$(ws)).data;
      return request.auth != null && w.open == true
        && request.auth.token.email.lower() in w.members;
    }

    match /workspaces/{ws} {
      allow read: if isOwner(ws)
        || (request.auth != null && request.auth.token.email.lower() in resource.data.members);
      allow write: if isOwner(ws);

      match /assignments/{id} {
        allow read: if isOwner(ws) || isMember(ws);
        allow create, delete: if isOwner(ws);
        // Сотрудник может менять только чекпоинты и статус
        allow update: if isOwner(ws) || (isMember(ws)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["checkpoints", "status"]));
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
